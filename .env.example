# ============================================================
# ✨ Brobot — environment configuration
# Copy this file to ".env" and fill in your values.
# ============================================================

# --- Discord Application (https://discord.com/developers/applications) ---
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
CLIENT_SECRET=your-oauth2-client-secret-here

# --- Dashboard ---
# Must match the OAuth2 redirect in the Discord Developer Portal:
#   <DASHBOARD_URL>/auth/callback
DASHBOARD_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/brobot

# --- Optional ---
# Custom "Invite Bot" link shown on the dashboard.
# Leave empty to auto-build from CLIENT_ID (permissions=8, scope=bot)
BOT_INVITE_URL=
# Localhost port the bot uses for instant prefix-sync pushes from the dashboard
INTERNAL_PORT=3001
# Delay in ms between each Server Builder action (roles/channels). 500-1000 recommended.
BUILDER_DELAY_MS=700
# Notifications feeds poll interval in ms (default 90000)
NOTIFICATIONS_INTERVAL_MS=90000
# Twitch live alerts (optional — https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Register slash commands to a single guild instantly (recommended while developing)
DEV_GUILD_ID=
# Comma separated Discord user IDs with bot-owner privileges
OWNER_IDS=
# Enable verbose debug logs
DEBUG=false
