  "description": "Brobot - Intuitive, beginner-friendly Discord bot & dashboard with a clean violet dashboard",
  "main": "bot/index.js",
  "scripts": {
    "bot": "node bot/index.js",
    "dashboard": "node dashboard/server.js",
