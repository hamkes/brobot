<%
  const pad = (n) => String(n).padStart(2, '0');
  const now = new Date();
  const updatedDate = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
%>
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <%- include('partials/head', { title, description }) %>
</head>
<body class="landing-body">

  <%- include('partials/nav', { loggedIn, loginUrl, inviteUrl, active }) %>

  <main>
    <section class="page-hero">
      <h1 class="page-title" data-i18n="legal_<%= doc.key %>_title">Legal</h1>
      <p class="page-sub" data-i18n="legal_<%= doc.key %>_intro">Please read carefully.</p>
      <p class="legal-updated"><span data-i18n="legal_last_updated">Last updated</span>: <%= updatedDate %></p>
    </section>

    <section class="section page-section prose">
      <% for (const section of sections) { %>
        <section id="<%= section.id %>" class="prose-section">
          <h2 data-i18n="<%= section.titleKey %>">Section</h2>
          <p data-i18n="<%= section.bodyKey %>">—</p>
        </section>
      <% } %>
      <p class="prose-footer">
        <span data-i18n="legal_contact">Questions? Reach us on our Discord support server.</span>
      </p>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
