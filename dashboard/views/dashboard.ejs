<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope.woff2" crossorigin>
  <style>
    @font-face {
      font-family: "Manrope";
      src: url("/fonts/manrope.woff2") format("woff2");
      font-weight: 200 800;
      font-display: swap;
    }
  </style>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Cairo:wght@400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <script>
    try { document.documentElement.setAttribute('data-theme', localStorage.getItem('brobot.theme') || 'dark'); } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
  </script>
</head>
<body class="dash-body">

  <div class="dash-layout">
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <a class="brand" href="/">
          <span class="brand-badge" aria-hidden="true"><img src="/img/brobot-logo-96.png" alt="" width="34" height="34" decoding="async"></span>
          <span class="brand-name" data-i18n="brand">BroBot</span>
        </a>
      </div>

      <div class="sidebar-guild">
        <button class="guild-picker" id="guildPicker" type="button">
          <img class="guild-icon" id="guildIcon" alt="" src="" style="display:none">
          <span class="guild-badge" id="guildBadge">?</span>
          <span class="guild-name" id="guildName" data-i18n="select_server">Select a server</span>
          <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="guild-menu" id="guildMenu" hidden></div>
      </div>

      <nav class="sidebar-nav" id="sidebarNav"></nav>

      <div class="sidebar-footer">
        <button class="lang-toggle sidebar-lang" id="langToggle" type="button">
          <span class="lang-ar">العربية</span>
          <span class="lang-en">English</span>
        </button>
        <button class="theme-switch" type="button" data-theme-toggle aria-label="Theme">
          <span class="theme-switch-label" data-i18n="theme_toggle">Theme</span>
          <span class="theme-switch-track">
            <span class="theme-opt theme-opt-light" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.7 4.7l1.6 1.6M17.7 17.7l1.6 1.6M2.6 12h2.2M19.2 12h2.2M4.7 19.3l1.6-1.6M17.7 6.3l1.6-1.6"/></svg></span>
            <span class="theme-opt theme-opt-dark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg></span>
          </span>
        </button>
        <a class="sidebar-link" href="/" data-i18n="home">Home</a>
        <a class="sidebar-link" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">
          <svg class="nav-emoji" style="width:16px;height:16px;flex:none" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.6 1.25a18.3 18.3 0 0 0-5.5 0 12.6 12.6 0 0 0-.61-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.04.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.22-2a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1-.01-.13c.13-.09.25-.19.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01c.12.1.25.2.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.11c.36.7.77 1.37 1.22 2a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6.02-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.68-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.41 0-1.34.96-2.42 2.16-2.42 1.21 0 2.18 1.09 2.16 2.42 0 1.33-.96 2.41-2.16 2.41Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.41 0-1.34.95-2.42 2.15-2.42 1.22 0 2.18 1.09 2.16 2.42 0 1.33-.94 2.41-2.16 2.41Z"/></svg>
          <span data-i18n="invite_bot">Invite Bot</span>
        </a>
      </div>
    </aside>

    <div class="dash-main">
      <header class="topbar">
        <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label="Menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="breadcrumbs">
          <span class="crumb-group" id="crumbGroup"></span>
          <span class="crumb-sep">/</span>
          <span class="crumb-page" id="crumbPage" data-i18n="overview">Overview</span>
        </div>
        <div class="topbar-right">
          <a class="btn btn-ghost btn-sm" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.6 1.25a18.3 18.3 0 0 0-5.5 0 12.6 12.6 0 0 0-.61-1.25.08.08 0 0 0-.08-.04 19.7 19.7 0 0 0-4.88 1.52.07.07 0 0 0-.04.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 6 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.22-2a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.9.08.08 0 0 1-.01-.13c.13-.09.25-.19.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01c.12.1.25.2.37.29a.08.08 0 0 1-.01.13c-.6.35-1.22.65-1.87.9a.08.08 0 0 0-.04.11c.36.7.77 1.37 1.22 2a.08.08 0 0 0 .08.03 19.8 19.8 0 0 0 6.02-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.68-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.41 0-1.34.96-2.42 2.16-2.42 1.21 0 2.18 1.09 2.16 2.42 0 1.33-.96 2.41-2.16 2.41Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.41 0-1.34.95-2.42 2.15-2.42 1.22 0 2.18 1.09 2.16 2.42 0 1.33-.94 2.41-2.16 2.41Z"/></svg>
            <span data-i18n="invite_bot">Invite Bot</span>
          </a>
          <span class="bot-status" id="botStatus">
            <span class="status-dot"></span>
            <span data-i18n="checking">Checking…</span>
          </span>
          <div class="user-chip">
            <img id="userAvatar" alt="" src="">
            <span id="userName"></span>
            <button class="icon-btn" id="logoutBtn" type="button" title="Logout">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
            </button>
          </div>
        </div>
      </header>

      <main class="content" id="content">
        <div class="loading-block">
          <div class="spinner"></div>
          <p data-i18n="loading">Loading…</p>
        </div>
      </main>
    </div>
  </div>

  <div class="toasts" id="toasts"></div>
  <div class="overlay" id="overlay" hidden></div>

  <script>
    window.__USER__ = <%- userJson %>;
  </script>
  <script src="/js/theme.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/pages.js"></script>
  <script src="/js/dashboard.js"></script>
</body>
</html>
